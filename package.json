{
  "name": "dsh-model-select-test",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: inline per-model connectivity test buttons and a one-click catalog update button in the composer model menu (patched derivative of @deepseek-ai/dsh-client-ui-model-selection).",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "build.py",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  }
}
